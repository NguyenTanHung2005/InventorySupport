{
  "expo": {
    "name": "InventorySupport",
    "slug": "InventorySupport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Inventory Support sử dụng camera để quét mã sản phẩm."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép Inventory Support chụp ảnh sản phẩm để nhận diện bằng AI.",
          "photosPermission": "Cho phép Inventory Support chọn ảnh sản phẩm từ thư viện."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2f6fed"
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.inventorysupport.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "86dc13eb-796b-43a1-b285-371c5f8fa84d"
      }
    }
  }
}
